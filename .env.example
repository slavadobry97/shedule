# Переменные окружения. Скопируйте в .env и заполните значения.
# Файл .env не коммитится.

# --- Google Sheets: источник расписания ---
# Сервисный аккаунт с доступом к таблице деканата.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CLIENT_EMAIL=scheduler@example.iam.gserviceaccount.com

# --- Служебный раздел /debug ---
# Пароль для входа. Без него отладка закрыта в проде полностью,
# в dev остаётся открытой.
DEBUG_PASSWORD=

# --- Сайт ---
NEXT_PUBLIC_SITE_URL=https://example.com
# Домен для Plausible (аналитика). Пусто — аналитика выключена.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- ИИ-чат отладки ---
# Провайдер через OpenAI-совместимый API: openrouter | groq | opencode | custom
#
# Почему не Gemini: Google AI Studio и Gemini API недоступны в Беларуси,
# поэтому привязка к нему означала бы, что чат не работает здесь.
AI_PROVIDER=openrouter

# Ключ провайдера. Для openrouter — с openrouter.ai/keys.
OPENROUTER_API_KEY=

# Модель. У openrouter бесплатные модели помечены суффиксом :free.
# По умолчанию — dots-studio/dots-3-note-preview:free: проверена на реальном
# объёме (7.5K токенов контекста) и стабильно доходит до ответа.
# Другие рабочие: nvidia/nemotron-3.5-lightning:free, liquid/lfm-2.5-2.6b:free,
# recursive/flint-v1.0:free. cohere/north-mini-code:free на большом промпте
# уходит в рассуждения целиком и возвращает пустой ответ.
AI_MODEL=dots-studio/dots-3-note-preview:free

# Белый список моделей для переключателя в чате: provider/model через запятую.
# Пусто — переключателя нет, работает только AI_MODEL. Проверены на реальном
# промпте расписания: dots-3-note-preview и nemotron-3.5-lightning.
# flint-v1.0 и north-mini-code на большом контексте уходят в рассуждения
# целиком и возвращают пустой ответ — их лучше не добавлять.
# Модели с суффиксом :free не тарифицируются; платные в список не попадают.
AI_ALLOWED_MODELS=openrouter/dots-studio/dots-3-note-preview:free,openrouter/nvidia/nemotron-3.5-lightning:free,openrouter/liquid/lfm-2.5-2.6b:free

# Потолок токенов на ответ. Reasoning-модели тратят часть лимита на внутренние
# рассуждения: при слишком малом значении ответ приходит пустым. По умолчанию 8192.
# AI_MAX_TOKENS=8192

# Для AI_PROVIDER=groq: GROQ_API_KEY=
# Для AI_PROVIDER=opencode: OPENCODE_API_KEY=
# Для AI_PROVIDER=custom: AI_BASE_URL= и AI_API_KEY=
