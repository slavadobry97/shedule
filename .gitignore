# next.js
/.next/
/out/

# Service worker next-pwa: генерируются на каждой сборке (dest: "public").
# Источник — worker/index.ts + runtimeCaching в next.config.mjs; сами файлы
# содержат precache-манифест конкретной сборки, в git им места нет.
# custom-sw.js — устаревшая ручная компиляция, удалена 14.11.
/public/sw.js
/public/workbox-*.js
/public/worker-*.js
/public/swe-worker-*.js
/public/custom-sw.js

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*
# ...но образец с перечнем переменных коммитим: по нему видно, что нужно настроить
!.env.example

# cloudflare
.wrangler
wrangler.toml.bak
.dev.vars

# typescript
*.tsbuildinfo
next-env.d.ts

# Личные документы (случайно попали в репо, убраны 28.10)
*.docx

# Локальный скретч сессий агента (скриншоты до/после) — не часть проекта
/Temp
